require 'base64'

default_platform(:ios)

platform :ios do
  desc "Build the app and send it to TestFlight / App Store Connect"
  lane :release_to_testflight do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].to_s.strip
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"].to_s.strip
    key_base64 = ENV["ASC_PRIVATE_KEY_BASE64"].to_s.strip
    key_content = Base64.decode64(key_base64).strip

    require 'fileutils'
    p8_dir = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(p8_dir)
    File.write(File.join(p8_dir, "AuthKey_#{key_id}.p8"), key_content + "\n")

    p8_local_dir = File.expand_path("./private_keys")
    FileUtils.mkdir_p(p8_local_dir)
    File.write(File.join(p8_local_dir, "AuthKey_#{key_id}.p8"), key_content + "\n")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    build_app(
      scheme: "UsaBem",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "3YB4FZDQ82",
        provisioningProfiles: {
          "app.requisiplus.clientios" => "ada46669-fe34-4931-8c4b-bc70f142d530"
        }
      },
      xcargs: "DEVELOPMENT_TEAM=3YB4FZDQ82 CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER=ada46669-fe34-4931-8c4b-bc70f142d530 PRODUCT_BUNDLE_IDENTIFIER=app.requisiplus.clientios"
    )

    begin
      puts "Testing App Store Connect API connection with Spaceship..."
      token = Spaceship::ConnectAPI::Token.create(
        key_id: key_id,
        issuer_id: issuer_id,
        filepath: File.join(p8_dir, "AuthKey_#{key_id}.p8")
      )
      Spaceship::ConnectAPI.token = token
      apps = Spaceship::ConnectAPI::App.all
      puts "Successfully connected to App Store Connect API! Found #{apps.count} apps."
      apps.each { |a| puts "App: #{a.name} (#{a.bundle_id})" }
    rescue => e
      puts "Spaceship test connection error: #{e.class} - #{e.message}"
    end

    upload_to_testflight(
      api_key: api_key,
      apple_id: "6612767809",
      team_id: "3YB4FZDQ82",
      app_identifier: "app.requisiplus.clientios",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end