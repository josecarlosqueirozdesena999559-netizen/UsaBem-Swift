default_platform(:ios)

platform :ios do
  desc "Build the app and send it to TestFlight / App Store Connect"
  lane :release_to_testflight do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    build_app(
      scheme: "UsaBem",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "3YB4FZDQ82",
        provisioningProfiles: {
          "app.requisiplus.clientios" => "ada46669-fe34-4931-8c4b-bc70f142d530"
        }
      },
      xcargs: "DEVELOPMENT_TEAM=3YB4FZDQ82 CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER=ada46669-fe34-4931-8c4b-bc70f142d530 PRODUCT_BUNDLE_IDENTIFIER=app.requisiplus.clientios"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "app.requisiplus.clientios",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end